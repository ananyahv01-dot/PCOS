# Python
**/__pycache__/
**/*.pyc
backend/.venv/
backend/artifacts/

# Node
frontend/node_modules/
frontend/dist/
# Exclude the lockfile + any npm config: they may pin a private registry that
# is unreachable inside the Docker build. The image resolves against the
# public registry instead (see Dockerfile).
frontend/package-lock.json
**/.npmrc

# Misc
.git/
.gitignore
*.md
.env
.env.*
